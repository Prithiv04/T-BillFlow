# ==============================================================================
# T-BillFlow 2.0 — Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in the values for your target network.
# NEVER commit .env to version control. All secret values are redacted here.
#
# Network options: mock | arbitrum_sepolia | arbitrum_one
# ==============================================================================

# ── Network ────────────────────────────────────────────────────────────────────
# Select the target network.
# mock             → Dry-run / unit tests, no blockchain connection required.
# arbitrum_sepolia → Arbitrum Sepolia testnet (chainId 421614).
# arbitrum_one     → Arbitrum One mainnet (chainId 42161) — PRODUCTION.
NETWORK=arbitrum_sepolia

# Set to true to force mock mode regardless of NETWORK setting.
AGENT_MOCK_MODE=false

# ── RPC Endpoints ──────────────────────────────────────────────────────────────
# Arbitrum Sepolia (testnet):
# Preferred: QuickNode Build-plan RPC endpoint (server-side only, do NOT expose to browser)
QUICKNODE_SEPOLIA_RPC_URL=
Fix the QuickNode CLI issue on my Windows machine.

Current problem:
PowerShell cannot find the `qn` command:

qn : The term 'qn' is not recognized as the name of a cmdlet, function, script file, or operable program.

Antigravity previously reported that QuickNode CLI `qn 0.6.1` was installed through Scoop, but my current PowerShell cannot resolve it.

Your task:

1. Diagnose why `qn` is not available in the current PowerShell PATH.
2. Verify whether QuickNode CLI is actually installed through Scoop.
3. Locate the installed `qn.exe`.
4. Fix the PATH/environment issue properly so `qn` works from a normal PowerShell terminal.
5. Do NOT unnecessarily reinstall QuickNode CLI if it is already installed.
6. Do NOT ask me to manually locate or edit PATH if you can perform the fix yourself.
7. Do NOT ask me to provide any API key or secret.
8. Do not expose or print any QuickNode credentials.

After fixing it, verify:

qn --version

It should successfully return the installed QuickNode CLI version (expected: 0.6.1).

Then verify:

qn auth login

If authentication requires an API key, STOP at that point and tell me to authenticate directly in my terminal. Never ask me to paste the API key into chat.

Do not create the QuickNode endpoint yet. First make sure the `qn` command works correctly.

After completing the PATH/CLI fix, report:
- What caused the issue
- What you changed
- The output/result of `qn --version`
- Whether `qn auth login` is ready to run
- Any manual step I still need to perform

Do not modify the T-BillFlow architecture or unrelated project files.# Fallback / Alternative: Private or public Arbitrum Sepolia RPC endpoint
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Arbitrum One (mainnet — PRODUCTION):
# EXTERNAL_DEPENDENCY: use a reliable private RPC endpoint.
# Public RPC: https://arb1.arbitrum.io/rpc (rate-limited, not suitable for production)
ARBITRUM_ONE_RPC_URL=

# ── Agent & Deployer Key ───────────────────────────────────────────────────────
# Private key of the agent/deployer wallet.
# CAUTION: Never commit a funded mainnet private key. Use a secrets manager in production.
# EXTERNAL_DEPENDENCY (production): Key management via AWS Secrets Manager, HashiCorp Vault, etc.
PRIVATE_KEY=

# ── Arbiscan / Etherscan Verification ─────────────────────────────────────────
# Used by forge script --verify and the tx history API route.
# Obtain from https://arbiscan.io/myapikey
ARBISCAN_API_KEY=

# ── Arbitrum Sepolia — Deployed Contract Addresses ────────────────────────────
# Populated by the deployment script after running:
#   forge script scripts/Deploy.s.sol --rpc-url arbitrum_sepolia --broadcast
TEST_TOKEN_ADDRESS=
AGENT_MANDATE_REGISTRY_ADDRESS=
RWA_STATE_ORACLE_ADDRESS=
AGENT_EXECUTION_GATE_ADDRESS=
TBILL_VAULT_ADDRESS=
COMPLIANCE_REGISTRY_ADDRESS=
RWA_ASSET_REGISTRY_ADDRESS=

# ── Arbitrum One — Production Contract Addresses ──────────────────────────────
# These are NOT pre-populated. Fill in after audited mainnet deployment.
# EXTERNAL_DEPENDENCY: production deployment requires audit + legal entity.
# Do NOT use testnet addresses here.
# SETTLEMENT_ASSET_ADDRESS defaults to native USDC on Arbitrum One if unset:
#   0xaf88d065e77c8cC2239327C5EDb3A432268e5831
SETTLEMENT_ASSET_ADDRESS=

# Mandate to use for agent execution (populated after grantMandate tx)
MANDATE_ID=

# ── RWA Oracle Data Provider & Live Feeds (Production) ────────────────────────
# Canonical Arbitrum One on-chain feeds:
#   OpenEden TBILL Price Oracle: 0xc0952c8ba068c887B675B4182F3A65420D045F46 (AggregatorV3)
#   OpenEden TBILL Token:        0xF84D28A8D28292842dD73D1c5F99476A80b6666A
#   Ondo USDY Token:             0x35e050d3C0eC2d29D269a8EcEa763a183bDF9A9D
RWA_PRICE_FEED_ADDRESS=0xc0952c8ba068c887B675B4182F3A65420D045F46

# Federal Reserve Economic Data (FRED) API key (free from https://fred.stlouisfed.org/docs/api/api_key.html)
# Used to fetch live secondary market US Treasury Bill yield curves (Series: DTB4WK, DTB3)
FRED_API_KEY=

# EXTERNAL_DEPENDENCY: Optional institutional REST endpoint (e.g. Ondo, Securitize, Superstate)
RWA_DATA_PROVIDER_URL=
RWA_PROVIDER_API_KEY=

# Private key of the approved oracle attestation signer.
# This address must be registered on-chain via RWAStateOracle.setApprovedProvider().
# EXTERNAL_DEPENDENCY: manage this key via a HSM or secrets manager in production.
# CAUTION: Never commit this key. Exposure allows unauthorized oracle updates.
ORACLE_ATTESTATION_SIGNER_KEY=

# ── Institutional Settlement / Custody ────────────────────────────────────────
# EXTERNAL_DEPENDENCY: requires custody agreement + broker-dealer relationship.
# See EXTERNAL_DEPENDENCY notes in agent/settlement.py.
CUSTODIAN_API_URL=
CUSTODIAN_CLIENT_ID=

# ── Agent Thresholds ──────────────────────────────────────────────────────────
# Minimum yield (%) before the agent considers executing a deposit.
YIELD_THRESHOLD=5.0

# Agent polling interval (seconds).
POLL_INTERVAL=60

# Current opportunity yield — synthetic/configured for testnet.
# In production, replace with a real data feed via rwa_provider.py.
CURRENT_YIELD=6.5

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
# These are passed to the browser via Next.js NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
NEXT_PUBLIC_YIELD_THRESHOLD=5.0
