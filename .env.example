# ==============================================================================
# T-BillFlow 2.0 — Environment Configuration
# ==============================================================================

# Network RPC URL (Arbitrum Sepolia)
# Public RPC: https://sepolia-rollup.arbitrum.io/rpc
# Or use Alchemy / Infura / QuickNode endpoint
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Deployer / Admin Private Key (WITHOUT 0x prefix for forge script or with 0x)
# DO NOT hardcode or commit real private keys.
PRIVATE_KEY=

# Arbiscan API Key for contract verification
# https://arbiscan.io/myapikey (or https://etherscan.io/myapikey)
ARBISCAN_API_KEY=

# Optional: Deployed contract addresses (populated after Phase 6 deployment)
TEST_TOKEN_ADDRESS=
AGENT_MANDATE_REGISTRY_ADDRESS=
RWA_STATE_ORACLE_ADDRESS=
AGENT_EXECUTION_GATE_ADDRESS=
TBILL_VAULT_ADDRESS=
